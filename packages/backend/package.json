{
  "name": "@jesus-in-practice/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "db:check": "node --experimental-strip-types scripts/check-database.mjs",
    "operator:access": "node --experimental-strip-types scripts/operator-access.mjs",
    "content:manage": "node --experimental-strip-types scripts/content.mjs"
  },
  "dependencies": {
    "@jesus-in-practice/content": "workspace:*",
    "pg": "8.23.1",
    "resend": "6.34.1",
    "stripe": "23.0.0",
    "twilio": "6.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "5.7.3"
  }
}
