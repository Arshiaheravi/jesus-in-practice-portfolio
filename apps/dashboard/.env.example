# Optional local override. Copy to .env.local. Public values are compiled into the browser.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DASHBOARD_URL=http://127.0.0.1:3001
NEXT_PUBLIC_APP_MODE=preview

# Live mode requires a rebuild. Keep all values below server-only.
APP_ORIGIN=http://127.0.0.1:3001
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Optional provider CA certificate; certificate verification is never disabled.
DATABASE_CA_CERT=

# Independent random secrets, at least 32 characters each. Keep stable with backups.
RATE_LIMIT_SECRET=
DESTINATION_HASH_SECRET=
UNSUBSCRIBE_SIGNING_SECRET=
CRON_SECRET=
MONITORING_SECRET=
# Set only when the hosting edge overwrites this header, stripping client values.
TRUSTED_CLIENT_IP_HEADER=

# Owner information must be accurate before collecting consent or sending.
OPERATOR_NAME=
OPERATOR_MAILING_ADDRESS=
# Your public support mailbox. Required for live consent, delivery and checkout.
SUPPORT_EMAIL=

ENABLE_EMAIL_DELIVERY=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

ENABLE_PHONE_VERIFICATION=false
ENABLE_SMS_DELIVERY=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

ENABLE_PAYMENTS=false
STRIPE_LIVE_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Integer cents per complete SMS segment, CAD; no unapproved default price.
SMS_SEGMENT_PRICE_CAD_CENTS=
COMMERCE_POLICY_APPROVED=false

# Imported scripture editions remain disabled until Canadian use and inventory are approved.
CONTENT_RIGHTS_ENABLED=false
ENABLE_AI_DRAFTING=false
OPENAI_API_KEY=
# Choose an explicitly supported Responses API model after reviewing cost and output quality.
OPENAI_CONTENT_MODEL=

# No default legal retention periods. See docs/production-operations.md.
ENABLE_RETENTION=false
RETENTION_POLICY_JSON=
# Backup utility only: 32 random bytes encoded as base64; store separately from backups.
BACKUP_ENCRYPTION_KEY=
