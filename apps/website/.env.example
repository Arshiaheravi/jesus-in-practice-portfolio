# Optional local overrides. Copy to .env.local; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DASHBOARD_URL=http://127.0.0.1:3001
# Keep false for previews. Enable only for an approved public HTTPS domain at launch.
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_APP_MODE=preview
# Public legal identity rendered by server components; required for launch.
OPERATOR_NAME=
OPERATOR_MAILING_ADDRESS=
# Rendered publicly where configured; use the same mailbox in both apps.
SUPPORT_EMAIL=
